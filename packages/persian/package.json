{
  "name": "@calendrix/persian",
  "version": "0.0.0",
  "description": "Persian (Jalali) calendar system for calendrix, backed by Intl.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@calendrix/core": "workspace:*"
  },
  "devDependencies": {
    "@calendrix/core": "workspace:*",
    "tsup": "^8.3.0",
    "vitest": "^2.1.2"
  }
}
